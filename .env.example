# Stock Anomaly Detector Configuration

# Data Fetching
STOCK_TICKER=AAPL
DATA_PERIOD=2y

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=stock_stream

# Stream Producer
STREAM_DELAY=0.3

# Anomaly Detection
ISOLATION_FOREST_CONTAMINATION=0.03
ROLLING_WINDOW=20

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_DIR=logs
LOG_FILE=anomalies.log
